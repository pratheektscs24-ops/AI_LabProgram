def print_board(state):
    for i in range(0, 9, 3):
        print(state[i:i+3])
    print()


def dfs(state, goal, visited, path):

    # Goal test
    if state == goal:
        return path

    visited.add(state)

    zero = state.index('0')
    row = zero // 3
    col = zero % 3

    moves = [
        (-1, 0, "Up"),
        (1, 0, "Down"),
        (0, -1, "Left"),
        (0, 1, "Right")
    ]

    for dr, dc, move in moves:

        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:

            new_zero = new_row * 3 + new_col

            board = list(state)

            # Swap blank with adjacent tile
            board[zero], board[new_zero] = \
                board[new_zero], board[zero]

            new_state = ''.join(board)

            if new_state not in visited:

                result = dfs(
                    new_state,
                    goal,
                    visited,
                    path + [move]
                )

                if result is not None:
                    return result

    return None


# -------------------------
# Main
# -------------------------

initial = "123406758"
goal = "123456780"

visited = set()

solution = dfs(initial, goal, visited, [])

if solution is None:
    print("No solution exists.")

else:
    print("Moves:")
    print(" -> ".join(solution))

    print("\nNumber of moves:", len(solution))

    # Display states
    current = initial

    print("\nInitial state:")
    print_board(current)

    for move in solution:

        zero = current.index('0')
        row = zero // 3
        col = zero % 3

        directions = {
            "Up": (-1, 0),
            "Down": (1, 0),
            "Left": (0, -1),
            "Right": (0, 1)
        }

        dr, dc = directions[move]

        new_row = row + dr
        new_col = col + dc

        new_zero = new_row * 3 + new_col

        board = list(current)

        board[zero], board[new_zero] = \
            board[new_zero], board[zero]

        current = ''.join(board)

        print("Move:", move)
        print_board(current)
